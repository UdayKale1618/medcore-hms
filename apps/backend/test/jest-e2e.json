{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["/node_modules/(?!@nestjs/testing)/"],
  "moduleNameMapper": {
    "^.*load-package\\.util(\\.js)?$": "<rootDir>/load-package.mock.js"
  }
}
